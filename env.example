# Copy to .env and fill in real values. config.py refuses to start
# without PG_DBNAME / PG_USER / PG_PASSWORD / PG_HOST -- there is
# intentionally no insecure default baked into the code anymore.

PG_DBNAME=cadastre_db
PG_USER=postgres
PG_PASSWORD=change-me
PG_HOST=localhost
PG_PORT=5432

# WGS 84 / India NSF LCC. Change only if you're deploying outside India
# and need a different national/regional equal-area or conformal CRS.
CADASTRE_SRID=7755

# Shared secret required (via the X-API-Key header) to call
# /api/v1/process-cadastre, /api/v1/process-cadastre-batch, and
# /api/v1/audit-infrastructure. Leave unset ONLY for local development --
# api.py prints a loud warning at startup if this is empty.
CADASTRE_API_KEY=

# Comma-separated list of origins allowed to call this API cross-origin,
# e.g. https://cadastre.example.gov.in . Leave unset if the frontend is
# served from this same API (same-origin, the default /app route).
CADASTRE_CORS_ORIGINS=

# Connection pool bounds and query safety limits.
CADASTRE_DB_POOL_MIN=2
CADASTRE_DB_POOL_MAX=10
CADASTRE_CONNECT_TIMEOUT_S=5
CADASTRE_IDLE_TXN_TIMEOUT_MS=30000
CADASTRE_MAX_BATCH_SIZE=25
